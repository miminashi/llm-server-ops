             case GGML_OP_GET_ROWS_BACK: // same as for GET_ROWS
             case GGML_OP_ROPE:          // positions not differentiable
                 ignore_src[1] = true;
@@ -7005,9 +7011,11 @@ void ggml_build_backward_expand(
